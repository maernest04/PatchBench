{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {"type": "null"},
    {
      "type": "object",
      "required": ["category", "affected_paths", "affected_symbols", "rationale"],
      "properties": {
        "category": {"enum": ["correctness", "preservation", "safety", "reliability", "efficiency", "state_lifecycle", "api_compatibility", "cli_filesystem", "security_policy", "refactor_preservation"]},
        "affected_paths": {"type": "array", "items": {"type": "string"}},
        "affected_symbols": {"type": "array", "items": {"type": "string"}},
        "rationale": {"type": "string", "minLength": 1},
        "verification_command": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  ]
}
