{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["outcome", "category", "affected_paths", "affected_symbols", "rationale"],
  "properties": {
    "outcome": {"enum": ["finding", "no_finding"]},
    "category": {"enum": ["correctness", "preservation", "safety", "reliability", "efficiency", "state_lifecycle", "api_compatibility", "cli_filesystem", "security_policy", "refactor_preservation", "none"]},
    "affected_paths": {"type": "array", "items": {"type": "string"}},
    "affected_symbols": {"type": "array", "items": {"type": "string"}},
    "rationale": {"type": "string"},
    "verification_command": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
