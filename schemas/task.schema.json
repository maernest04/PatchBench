{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "version", "repository", "runtime", "constraints", "checks"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "repository": {"type": "string", "minLength": 1},
    "runtime": {
      "type": "object",
      "required": ["image"],
      "properties": {"image": {"type": "string", "minLength": 1}}
    },
    "constraints": {
      "type": "object",
      "required": ["timeout_seconds", "memory_megabytes", "cpu_cores"],
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "memory_megabytes": {"type": "integer", "minimum": 1},
        "cpu_cores": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "checks": {"type": "array", "minItems": 1}
  }
}
